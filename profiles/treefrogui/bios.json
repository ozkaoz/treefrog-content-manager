      "system_id": "psx",
      "system_name": "PlayStation 1",
      "name": "PlayStation BIOS (SCPH)",
      "description": "Any 512 KiB PS1 BIOS; required when PS1 content present or PS1 core enabled. Multiple variants satisfy requirement.",
      "required": "conditional",
      "requirement": {
        "scope": "conditional",
        "mandatory_when": "psx_content_present OR psx_system_enabled",
        "condition": "content for system psx/ps1/ps1r present in source or SD, or system enabled in profile",
        "fallback": "recommended if PS1 content will be used; HLE fallback has glitches"
      },
      "variants": [
        {
          "id": "ps1_scph1001",
          "filenames": ["scph1001.bin"],
          "aliases": ["SCPH1001.BIN", "scph1001.BIN"],
          "expected_size": 524288,
          "hashes_sha256": [],
          "notes": "Variant A - any valid dump satisfies PS1 requirement"
        },
        {
          "id": "ps1_scph5501",
          "filenames": ["scph5501.bin"],
          "aliases": ["SCPH5501.BIN"],
          "expected_size": 524288,
          "hashes_sha256": [],
          "notes": "Variant B"
        },
        {
          "id": "ps1_scph5500",
          "filenames": ["scph5500.bin"],
          "aliases": ["SCPH5500.BIN"],
          "expected_size": 524288,
          "hashes_sha256": [],
          "notes": "Variant C - Japanese"
        }
      ],
      "accepted_filenames": ["scph1001.bin", "scph5501.bin", "scph5500.bin", "scph5502.bin", "scph7001.bin", "scph*.bin"],
      "accepted_patterns": ["scph*.bin", "*.bin"],
      "destinations": ["cubegm/bios", "cubegm/bios/", "cubegm/cores/.pcsx4all/bios", "cubegm/.pcsx4all/bios"],
      "primary_destination": "cubegm/bios",
      "expected_size": 524288,
      "hashes_sha256": [],
      "hash_required": false,
      "aliases": ["SCPH1001.BIN", "SCPH5501.BIN", "scph*.bin"],
      "archive": {
        "mode": "payload",
        "description": "PS1 BIOS is never inside an archive that should be extracted; .zip containing BIOS is payload or manual_review. If BIOS is inside a container ZIP, planner will treat as container per archive_policy.",
        "payload_extensions": [".bin"],
        "container_handling": "manual_review"
      },
      "verification": {
        "states": ["missing", "found_valid", "found_invalid", "found_unknown", "duplicate", "conflict", "not_required"],
