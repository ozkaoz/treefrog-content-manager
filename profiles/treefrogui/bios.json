  "global_settings": {
    "hash_algorithm": "SHA-256",
    "verification_states": ["missing", "found_valid", "found_invalid", "found_unknown", "duplicate", "conflict", "not_required"],
    "archive_handling": "reuse Phase 2A archive infrastructure (inspect, payload vs container, temp workspace)"
  },
