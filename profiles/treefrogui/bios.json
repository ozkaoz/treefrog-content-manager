{
  "schema_version": "1.0.0",
  "profile_version": "1.0.0",
  "description": "BIOS / firmware files — declarative rules for discovery, verification, import, backup, reveal. User-supplied only; never download/bundle copyrighted BIOS.",
  "destination_root": "cubegm/bios",
  "bios_rules": [
    {
      "system": "PlayStation 1",
      "core": "pcsx_rearmed_libretro.so / cubegm/pcsx4all",
      "folders": ["PS", "ps1", "psx", "ps1r"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["scph*.bin", "*.bin"],
      "expected_size": 524288,
      "required": "recommended (strongly recommended; HLE fallback causes glitches/broken saves)",
      "hash_optional": true,
      "region_variants": ["scph1001.bin", "scph5500.bin", "scph5501.bin", "scph5502.bin", "scph7001.bin"],
      "notes": "Any 512 KiB PS1 BIOS auto-detected; case-insensitive, prefers scph* prefix. Legacy paths: cubegm/cores/.pcsx4all/ etc (old cards) — prefer cubegm/bios/.",
      "legacy_alternates": ["cubegm/cores/.pcsx4all/", "cubegm/cores/.pcsx4all/bios/", "cubegm/.pcsx4all/", "cubegm/.pcsx4all/bios/"],
      "guide": "docs/cores/ps1.md"
    },
    {
      "system": "GBA (gpsp)",
      "core": "gpsp_libretro.so",
      "folders": ["GBA", "gba", "mgba", "gbaf"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["gba_bios.bin"],
      "expected_size": 16384,
      "required": "required for gpsp core",
      "hash_known": "a860a8c0b6d573d191e4ec7db1b33b04ccf2454a7df67b3a6de030423b6a436",
      "notes": "Official Nintendo GBA BIOS — user-supplied only"
    },
    {
      "system": "Odyssey² / Videopac",
      "core": "o2em_libretro.so",
      "folders": ["o2em"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["o2rom.bin"],
      "expected_size": 1024,
      "expected_md5": "562d5ebf9e030a40d6fabfc2f33139fd",
      "required": "required",
      "notes": "Exact filename o2rom.bin"
    },
    {
      "system": "Famicom Disk System",
      "core": "fceumm_libretro.so (fds)",
      "folders": ["fds"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["disksys.rom"],
      "expected_size": 8192,
      "required": "required",
      "notes": "FDS BIOS disksys.rom"
    },
    {
      "system": "Neo Geo (geolith/neogeo)",
      "core": "geolith_libretro.so / fbalpha2012_neogeo_libretro.so",
      "folders": ["geolith", "neogeo"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["neogeo.zip"],
      "required": "required",
      "notes": "neogeo.zip BIOS — do not unpack"
    },
    {
      "system": "Sega CD / Mega CD",
      "core": "genesis_plus_gx_libretro.so (segacd)",
      "folders": ["segacd"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["bios_CD_U.bin", "bios_CD_E.bin", "bios_CD_J.bin"],
      "required": "required (region-specific)",
      "region_variants": ["bios_CD_U.bin (USA)", "bios_CD_E.bin (EU)", "bios_CD_J.bin (JP)"],
      "notes": "Region BIOS files"
    },
    {
      "system": "PC-FX",
      "core": "mednafen_pcfx_libretro.so",
      "folders": ["pcfx"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["pcfx.rom"],
      "required": "required",
      "notes": "PC-FX BIOS"
    },
    {
      "system": "PC-88",
      "core": "quasi88_libretro.so",
      "folders": ["pc8800"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["*.rom"],
      "required": "required",
      "notes": "NEC PC-88 BIOS files (quasi88 expects multiple)"
    },
    {
      "system": "Amiga",
      "core": "uae_libretro.so",
      "folders": ["amiga"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["kick13.rom", "kick20.rom"],
      "required": "required",
      "notes": "Kickstart ROM — prefer kick13.rom (1.3 recommended), kick20.rom optional; Kickstart 3.0/3.1 not supported",
      "guide": "docs/cores/amiga.md"
    },
    {
      "system": "Atari ST",
      "core": "castaway_libretro.so",
      "folders": ["atari-st"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["tos*.img", "tos*.rom"],
      "required": "required",
      "notes": "TOS ROM image"
    },
    {
      "system": "DOS / pico286",
      "core": "cubegm/pico286",
      "folders": ["pico286"],
      "destination": "cubegm/bios/",
      "accepted_patterns": ["x86BOOT.img"],
      "required": "recommended (bundled FreeDOS)",
      "notes": "FreeDOS + CuteMouse boot image (GPLv2). Bundled at cubegm/bios/x86BOOT.img; if missing user can copy 144m/x86BOOT.img from FreeDOS 1.4 Floppy Edition"
    },
    {
      "system": "C64 optional JiffyDOS",
      "core": "vice_x64_libretro.so (c64)",
      "folders": ["c64", "c64sc"],
      "destination": "cubegm/bios/vice/",
      "accepted_patterns": ["*.bin"],
      "required": "optional",
      "notes": "VICE core includes standard C64 ROM data; optional JiffyDOS files belong in cubegm/bios/vice/"
    },
    {
      "system": "Wolfenstein 3D",
      "core": "ecwolf_libretro.so",
      "folders": ["wolf3d"],
      "destination": "roms/wolf3d/",
      "accepted_patterns": ["ecwolf.pk3"],
      "required": "required",
      "notes": "Game data + ecwolf.pk3 — see docs/cores/wolf3d.md"
    }
  ],
  "ui_requirements": {
    "supported_actions": ["discover", "verify", "import", "replace", "backup_current", "reveal_destination"],
    "never_download_copyrighted": true
  }
}
